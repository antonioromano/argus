#!/bin/sh
# argus-signal — post a native agent lifecycle signal to the local Argus server.
#
# Invoked by injected agent hooks (Claude/Gemini) or notify (Codex). STRICTLY
# fire-and-forget: a dead or slow server must never block or fail the agent, so
# every failure path exits 0 and the curl call is time-boxed. No Node dependency.
#
# Usage:
#   argus-signal --session <id> --state <running|waiting|idle> [--prompt-from-stdin] [--hook-stdin]
#   argus-signal --session <id> --hook-stdin            (metadata only, no state)
#   argus-signal --session <id> --approve               (PreToolUse auto-approval, F5)
#   argus-signal --session <id> --activity              (activity timeline, beta F6)
#
# --activity: observation only. Forward the first 16 KB of the hook JSON (a
# PostToolUse for a big Write carries the whole file; the server builds a
# <=200-character summary from named fields and reads no content) and print
# NOTHING, so the hook can never change what Claude does. The body is
# "<token>\n<capped hook JSON>" as text/plain: the payload may be cut mid-JSON,
# so it cannot be embedded in a JSON body, and the token stays out of argv.
#
# --approve: forward the PreToolUse hook JSON to the server, which decides from
# its own rules and session table. The ONLY thing ever written to stdout is the
# server's reply when it is a hookSpecificOutput object; every failure (no
# wiring, payload over the cap, server down, slow past 1s, non-200) prints
# nothing, which leaves Claude's normal permission flow in charge. Silence
# means "ask", never "allow".
#
# --hook-stdin: the hook's stdin is Claude's hook JSON; forward its session_id
# and transcript_path (the usage meter and Resume read them). Without --state
# only that metadata is posted (SessionStart, which has no lifecycle meaning).
#
# Env (injected into the agent process by Argus at spawn):
#   ARGUS_SIGNAL_URL    base URL, e.g. http://127.0.0.1:5757/api/agent-signals
#   ARGUS_SIGNAL_TOKEN  per-session HMAC token
set -u

SESSION=""
STATE=""
PROMPT_FROM_STDIN=0
HOOK_STDIN=0
APPROVE=0
ACTIVITY=0
while [ $# -gt 0 ]; do
  case "$1" in
    --session) SESSION="${2:-}"; shift 2 ;;
    --state) STATE="${2:-}"; shift 2 ;;
    --prompt-from-stdin) PROMPT_FROM_STDIN=1; shift ;;
    --hook-stdin) HOOK_STDIN=1; shift ;;
    --approve) APPROVE=1; shift ;;
    --activity) ACTIVITY=1; shift ;;
    *) shift ;;
  esac
done

# Missing wiring (feature off, or invoked outside a signal-enabled session):
# stay silent and succeed so the agent is unaffected.
[ -n "${ARGUS_SIGNAL_URL:-}" ] || exit 0
[ -n "${ARGUS_SIGNAL_TOKEN:-}" ] || exit 0
[ -n "$SESSION" ] || exit 0

if [ "$ACTIVITY" -eq 1 ]; then
  HOOK=$(head -c 16384 2>/dev/null || true)
  cat >/dev/null 2>&1 || true
  [ -n "$HOOK" ] || exit 0
  { printf '%s\n' "${ARGUS_SIGNAL_TOKEN}"; printf '%s' "$HOOK"; } \
    | curl -s -m 1 -X POST -H 'Content-Type: text/plain' --data-binary @- \
        "${ARGUS_SIGNAL_URL%/}/$SESSION/activity" >/dev/null 2>&1 || true
  exit 0
fi

if [ "$APPROVE" -eq 1 ]; then
  # Cap a little under the server's 512 KB body limit. A bigger payload (a
  # large Write) gets no decision; the remainder is drained so the hook never
  # dies on EPIPE.
  CAP=500000
  HOOK=$(head -c "$CAP" 2>/dev/null || true)
  EXTRA=$(head -c 1 2>/dev/null | wc -c | tr -d ' ')
  cat >/dev/null 2>&1 || true
  [ "${EXTRA:-0}" -eq 0 ] || exit 0
  [ -n "$HOOK" ] || exit 0
  # The hook JSON is embedded verbatim as the "hook" value; if it is not valid
  # JSON the server rejects the body and we print nothing.
  OUT=$(
    { printf '{"token":"%s","hook":' "$(printf '%s' "${ARGUS_SIGNAL_TOKEN}" | sed 's/\\/\\\\/g; s/"/\\"/g')"; printf '%s' "$HOOK"; printf '}'; } \
      | curl -s -f -m 1 -X POST -H 'Content-Type: application/json' --data-binary @- \
          "${ARGUS_SIGNAL_URL%/}/$SESSION/pre-tool-use" 2>/dev/null
  ) || exit 0
  case "$OUT" in
    '{"hookSpecificOutput":'*) printf '%s\n' "$OUT" ;;
  esac
  exit 0
fi

[ -n "$STATE" ] || [ "$HOOK_STDIN" -eq 1 ] || exit 0

# JSON-escape backslashes and double quotes (minimal; values are simple).
esc() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

# The FIRST "<key>":"<string>" pair in the hook JSON. Claude writes its own
# top-level fields (session_id, transcript_path, message, ...) before the
# tool's arguments, so the first match is the real one; a tool_input that
# happens to carry a "session_id" (an MCP tool parameter, say) comes later and
# must never win. Best-effort: not robust to escaped quotes inside the value —
# the server validates every field and drops whatever doesn't parse.
field() {
  printf '%s' "$RAW" | tr '\n' ' ' \
    | grep -o "\"$1\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" | head -n1 \
    | sed "s/^\"$1\"[[:space:]]*:[[:space:]]*\"//; s/\"\$//"
}

# Only the head of stdin is parsed: the fields we want sit at the start, and a
# PreToolUse for a multi-MB Write carries the whole file. The rest is drained
# unread (so the hook never dies on EPIPE) at pipe speed, not parsed.
RAW=""
if [ "$PROMPT_FROM_STDIN" -eq 1 ] || [ "$HOOK_STDIN" -eq 1 ]; then
  RAW=$(head -c 8192 2>/dev/null || true)
  cat >/dev/null 2>&1 || true
fi
PROMPT=""
[ "$PROMPT_FROM_STDIN" -eq 1 ] && PROMPT=$(field message)
CLAUDE_ID=""
TRANSCRIPT=""
if [ "$HOOK_STDIN" -eq 1 ]; then
  CLAUDE_ID=$(field session_id)
  TRANSCRIPT=$(field transcript_path)
fi

BODY=$(printf '"token":"%s"' "$(esc "${ARGUS_SIGNAL_TOKEN}")")
[ -n "$STATE" ] && BODY="$BODY$(printf ',"state":"%s"' "$(esc "$STATE")")"
[ -n "$PROMPT" ] && BODY="$BODY$(printf ',"promptText":"%s"' "$(esc "$PROMPT")")"
[ -n "$CLAUDE_ID" ] && BODY="$BODY$(printf ',"claudeSessionId":"%s"' "$(esc "$CLAUDE_ID")")"
[ -n "$TRANSCRIPT" ] && BODY="$BODY$(printf ',"transcriptPath":"%s"' "$(esc "$TRANSCRIPT")")"
# Metadata-only call that found nothing to send: stay silent.
[ -n "$STATE" ] || [ -n "$CLAUDE_ID" ] || [ -n "$TRANSCRIPT" ] || exit 0
BODY="{$BODY}"

URL="${ARGUS_SIGNAL_URL%/}/$SESSION"
# Send the body via stdin (--data-binary @-), never `-d "$BODY"`: the token is a
# per-session credential and `-d` would place it in curl's argv, exposing it to
# local `ps aux` for the request's lifetime.
printf '%s' "$BODY" | curl -s -m 1 -X POST -H 'Content-Type: application/json' --data-binary @- "$URL" >/dev/null 2>&1 || true
exit 0
